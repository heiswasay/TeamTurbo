rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is an active admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'wasey351@gmail.com' ||
        request.auth.token.email == 'wasay@teamturbo.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Work Entries Collections
    match /work_entries/{entryId} {
      allow read, write: if true;
    }

    match /workEntries/{entryId} {
      allow read, write: if true;
    }

    // Assigned Tasks Collections
    match /assigned_tasks/{taskId} {
      allow read, write: if true;
    }

    match /assignedTasks/{taskId} {
      allow read, write: if true;
    }

    // Handovers Collection
    match /handovers/{handoverId} {
      allow read, write: if true;
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // Companies Collection
    match /companies/{companyId} {
      allow read, write: if true;
    }

    // Chat / Feedback Messages Collection
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }
  }
}

